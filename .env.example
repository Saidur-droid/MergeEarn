# Public application URL. Use http://localhost:5173 locally and the canonical HTTPS URL in production.
APP_URL=

# GitHub OAuth App. Callback: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase trusted server configuration. Never expose the service-role key to Vite/browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random secret used to encrypt GitHub access tokens stored in the session table.
SESSION_ENCRYPTION_KEY=

# Nimiq public addresses and canonical RPC endpoint.
# VITE_NIMIQ_FUNDING_ADDRESS and NIMIQ_FUNDING_ADDRESS MUST contain the same public address.
VITE_NIMIQ_FUNDING_ADDRESS=
NIMIQ_FUNDING_ADDRESS=
NIMIQ_PAYOUT_SOURCE_ADDRESS=
NIMIQ_RPC_URL=

# Optional OpenAI-compatible issue-to-bounty copilot. The app has a manual-safe fallback when omitted.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
